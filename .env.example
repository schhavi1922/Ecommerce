# Reference only: Spring Boot does not automatically load this file.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USERNAME=postgres
# Set DB_PASSWORD in your shell or IDE environment; never commit a real password.
